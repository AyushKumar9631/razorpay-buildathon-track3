# Database
DATABASE_URL=postgresql://user:password@localhost:5432/revenue_recovery
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Redis (optional for local dev, can use Railway Redis in production)
REDIS_URL=redis://localhost:6379

# JWT Secret
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Settings
DEBUG=True
APP_NAME=AI Revenue Recovery
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Email (optional - for future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS (optional - for future)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Celery (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Model Settings
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Feature Flags
ENABLE_ML_PREDICTIONS=True
ENABLE_AUTO_RECOVERY=True
ENABLE_NOTIFICATIONS=False
